# ==========================================
# Lightning-Joint-Simulation-Engine v1.0.0
# 專用 .gitignore
# ==========================================

# ------------------------------------------
# 1. 絕對禁止上傳 (核心安全)
# ------------------------------------------
.env
.env.*
*.key
*.pem
secrets/
config/bot_registry.yaml          # 內含真實 Token，請改用 bot_registry.example.yaml
config_private.*
private/

# ------------------------------------------
# 2. Python 編譯快取
# ------------------------------------------
__pycache__/
*.pyc
*.pyo
*.so
dist/
build/
*.egg-info/
.eggs/

# ------------------------------------------
# 3. 資料庫與日誌 (執行時產生，勿上傳)
# ------------------------------------------
database/events.db
*.db
*.sqlite3
logs/
*.log
dashboard/status.json             # 本地執行會覆蓋，改用 status.example.json

# ------------------------------------------
# 4. AI 模型 / 音檔 / 權重 (容量大且為核心)
# ------------------------------------------
models/
checkpoints/
weights/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.pb
*.wav
*.mp3
*.flac
*.aac

# ------------------------------------------
# 5. 訓練資料與輸出
# ------------------------------------------
datasets/
data/
outputs/
results/
runs/
tensorboard/

# ------------------------------------------
# 6. 開發環境與作業系統
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.cache/
tmp/
temp/
*.tmp

# ------------------------------------------
# 7. 壓縮檔 / 安裝檔 (避免 repo 肥大)
# ------------------------------------------
*.zip
*.apk
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------
# 8. Git 相關 (保留 .gitignore 本身)
# ------------------------------------------
!.gitignore
.gitattributes

# ------------------------------------------
# 9. CI / 測試 暫存
# ------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
# ==========================================
# 補充：Bot 與 Token 相關（務必隱藏）
# ==========================================
**/bot_registry.yaml
**/bot_token*.txt
**/*token*.json
**/*secret*.yaml
**/*secret*.json
c# ==========================================
# Lightning-Joint-Simulation-Engine v1.0.0
# 完整 .gitignore (含支付、Bot、金鑰)
# ==========================================

# ---------- 絕對禁止進入 ----------
*.zip
*.apk
.git
*.exe
*.msi

# ---------- 預設隱藏所有檔案 ----------
*

# ---------- 公開 Markdown 文件 ----------
!*.md
!README.md
!LICENSE

# ---------- 保留 Git 設定 ----------
!.gitignore

# ---------- Python 快取 ----------
__pycache__/
*.pyc
*.pyo

# ---------- AI 模型 / 權重 ----------
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5

# ---------- 環境設定與金鑰 ----------
.env
.env.*
*.key
*.pem
secrets/
private/
secret/
config_private.*

# ---------- 日誌 ----------
*.log
logs/

# ---------- 暫存 / Cache ----------
.cache/
tmp/
temp/

# ---------- 編輯器 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS 垃圾 ----------
.DS_Store
Thumbs.db

# ---------- 音檔 (TTS / 語音) ----------
*.wav
*.mp3
*.flac
*.aac
*.ogg

# ---------- 訓練資料與輸出 ----------
datasets/
data/
checkpoints/
outputs/
runs/
weights/
models/
model/

# ---------- Bot 設定檔 (含所有 Token) ----------
bot_registry.yaml
*_token.*
*secret*.yaml
*secret*.json
credentials.json
oauth2.json
*.bot.token

# ---------- 支付相關 (Line Pay / Google Pay / 微信) ----------
# Line / Line Pay
*line*.key
*line*.pem
*line*.json
*linepay*.key
*linepay*.pem
line_config.yaml
linepay_config.yaml

# Google Pay
*googlepay*.key
*googlepay*.json
*google_pay*.pem
googlepay_config.yaml

# 微信支付 (雖然您已列入，但補充完整)
*wechat*.key
*wechat*.pem
wechat_config.yaml
wxpay_cert*.pem
wxpay_key*.pem

# 通用支付憑證
cert/
certs/
*.crt
*.csronfig_private.yaml
