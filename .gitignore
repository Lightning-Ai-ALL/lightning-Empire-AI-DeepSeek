.git
# =========================
# 隱藏所有檔案
# =========================
*

# =========================
# 公開 Markdown 文件
# =========================
!*.md

# 公開 README
!README.md

# =========================
# 保留 Git 設定
# =========================
!.gitignore

# =========================
# 隱藏常見資料
# =========================

# Python
__pycache__/
*.pyc

# AI模型 / 權重
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# 環境設定
.env
.env.*

# 金鑰
*.key
*.pem
secrets/

# 日誌
*.log

# Cache
.cache/
tmp/
temp/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
# TTS 音檔
*.wav
*.mp3
*.flac

# 訓練資料
datasets/
data/

# 模型輸出
checkpoints/
outputs/
runs/
